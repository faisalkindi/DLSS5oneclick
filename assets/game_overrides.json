      "ofa_grid": 2,
      "ofa_perf": 10,
      "engine_velocity": true,
      "reset_mode": 1,
      "light_stab": true,
      "light_stab_strength": 0.35,
      "work_resolution": 100,
      "auto_profile_applied": 0
    },
    {
      "match_exe": ["MassEffect1", "MassEffect2", "MassEffect3", "MassEffect"],
